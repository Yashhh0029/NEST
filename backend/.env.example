# Environment Configuration Example
PROJECT_NAME="NEST - AI Community Matching Platform"
ENVIRONMENT="development"  # "development" or "production"
API_V1_STR="/api"
ENABLE_DOCS=True  # Set to False to disable OpenAPI /docs in high-security production

# Database (PostgreSQL 16 + pgvector)
# Supports postgresql:// and postgres:// (auto-normalized)
# Example: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/nest_db"

# Security & JWT (Generate a 256-bit secret for production: openssl rand -hex 32)
JWT_SECRET="GENERATE_A_SECURE_JWT_SECRET_AT_LEAST_32_CHARS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS & Frontend URL
FRONTEND_URL="http://localhost:5173"
# Comma-separated or JSON array of allowed origins for browser CORS:
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# ML Embeddings
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# Google Maps Platform (Phase 6 Location Intelligence)
# Server-side API key (server/IP-restricted where practical) for Places API (New).
GOOGLE_MAPS_SERVER_API_KEY="your-google-maps-backend-server-api-key-here"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Email Verification (Resend / SMTP)
EMAIL_PROVIDER="resend"  # "resend", "smtp", "sendgrid", or "test"
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="NEST Verification <onboarding@resend.dev>"

