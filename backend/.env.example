# Environment Configuration Example
PROJECT_NAME="NEST - AI Community Matching Platform"
ENVIRONMENT="development"
API_V1_STR="/api"

# Database (PostgreSQL 16 + pgvector)
# Example: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/nest_db"

# Security & JWT
JWT_SECRET="GENERATE_A_SECURE_JWT_SECRET"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS & Frontend
FRONTEND_URL="http://localhost:5173"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ML Embeddings
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# Google Maps Platform (Phase 6 Location Intelligence)
# Server-side API key (server/IP-restricted where practical) for Places API (New) & Geocoding API.
GOOGLE_MAPS_SERVER_API_KEY="your-google-maps-backend-server-api-key-here"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Email Verification (Resend / SMTP)
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="NEST Verification <onboarding@resend.dev>"
