# Environment Configuration Example
PROJECT_NAME="NEST - AI Community Matching Platform"
ENVIRONMENT="development"
API_V1_STR="/api"

# Database (PostgreSQL 16 + pgvector)
# Example: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME

# Security & JWT
JWT_SECRET=GENERATE_A_SECURE_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS & Frontend
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ML Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Google Maps Platform (Phase 6 Location Intelligence)
# Server-side API key restricted to Geocoding, Places (New), and Routes API.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY
