VITE_API_URL=http://127.0.0.1:8000

# Google Maps Platform (Phase 6 Location Intelligence)
# Client-side API key restricted by HTTP Referrer (e.g., http://localhost:3000/*)
# and API restrictions (Maps JavaScript API and Places API (New)).
VITE_GOOGLE_MAPS_API_KEY="your-google-maps-browser-api-key-here"

# Google Identity Services Client ID
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

